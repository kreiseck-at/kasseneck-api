{
  "_note": "Shared cases for the shift helpers (npm @kreiseck/kasseneck-api and Dart kasseneck_api): sumDenominations (cents value as key, count as value; null = not a valid count) and parseCentsAllowZero (typed amount -> cents; null = invalid input) and shiftTipLines (tips of one employee -> lines; earned = received immediately + retained, always shown; retained, paid out and open only when not 0; everything 0 -> no lines). Never round, never guess.",
  "sumDenominations": [
    { "denominations": {}, "expected": 0 },
    { "denominations": { "100": 1, "200": 1, "500": 1, "2000": 1 }, "expected": 2800 },
    { "denominations": { "2000": 2, "5000": 1, "20000": 1 }, "expected": 29000 },
    { "denominations": { "1": 3, "2": 1, "5": 4 }, "expected": 25 },
    { "denominations": { "50000": 2 }, "expected": 100000 },
    { "denominations": { "1000": 0, "500": 0 }, "expected": 0 },
    { "denominations": { "10000": 100000 }, "expected": 1000000000 },
    { "denominations": { "300": 1 }, "expected": null },
    { "denominations": { "0": 1 }, "expected": null },
    { "denominations": { "100000": 1 }, "expected": null },
    { "denominations": { "1000": -1 }, "expected": null },
    { "denominations": { "1000": 1.5 }, "expected": null },
    { "denominations": { "1000": "2" }, "expected": null },
    { "denominations": { "1000": 100001 }, "expected": null },
    { "denominations": { "10.00": 1 }, "expected": null },
    { "denominations": { "0500": 1 }, "expected": null },
    { "denominations": { "": 1 }, "expected": null },
    { "denominations": null, "expected": null },
    { "denominations": [], "expected": null }
  ],
  "parseCentsAllowZero": [
    { "text": "0", "expected": 0 },
    { "text": "0,00", "expected": 0 },
    { "text": "0.0", "expected": 0 },
    { "text": "1", "expected": 100 },
    { "text": "12", "expected": 1200 },
    { "text": "12,5", "expected": 1250 },
    { "text": "12.5", "expected": 1250 },
    { "text": "12,05", "expected": 1205 },
    { "text": "0,01", "expected": 1 },
    { "text": " 290,00 ", "expected": 29000 },
    { "text": "1000", "expected": 100000 },
    { "text": "007", "expected": 700 },
    { "text": "", "expected": null },
    { "text": "   ", "expected": null },
    { "text": ",50", "expected": null },
    { "text": "12,", "expected": null },
    { "text": "12,345", "expected": null },
    { "text": "1.000", "expected": null },
    { "text": "1.000,00", "expected": null },
    { "text": "1 000", "expected": null },
    { "text": "-5", "expected": null },
    { "text": "+5", "expected": null },
    { "text": "1e3", "expected": null },
    { "text": "12,5 €", "expected": null },
    { "text": "€ 12", "expected": null },
    { "text": "abc", "expected": null },
    { "text": "99999999999999999999", "expected": null }
  ],
  "shiftTipLines": [
    { "tip": { "registerUserId": "ru_kellner", "name": "Ben Kellner", "receivedImmediatelyCents": 400, "retainedCents": 0, "paidOutCents": 0, "openCents": 400 }, "expected": [{ "key": "shift_receipt.tip_earned", "cents": 400 }, { "key": "shift_receipt.tip_open", "cents": 400 }] },
    { "tip": { "registerUserId": "ru_kellner", "name": "Ben Kellner", "receivedImmediatelyCents": 400, "retainedCents": 150, "paidOutCents": 250, "openCents": 150 }, "expected": [{ "key": "shift_receipt.tip_earned", "cents": 550 }, { "key": "shift_receipt.tip_retained", "cents": 150 }, { "key": "shift_receipt.tip_paid_out", "cents": 250 }, { "key": "shift_receipt.tip_open", "cents": 150 }] },
    { "tip": { "registerUserId": "ru_kellner", "name": "Ben Kellner", "receivedImmediatelyCents": 400, "retainedCents": 0, "paidOutCents": 400, "openCents": 0 }, "expected": [{ "key": "shift_receipt.tip_earned", "cents": 400 }, { "key": "shift_receipt.tip_paid_out", "cents": 400 }] },
    { "tip": { "registerUserId": "ru_kellner", "name": "Anna Chef", "receivedImmediatelyCents": 0, "retainedCents": 0, "paidOutCents": 0, "openCents": 300 }, "expected": [{ "key": "shift_receipt.tip_earned", "cents": 0 }, { "key": "shift_receipt.tip_open", "cents": 300 }] },
    { "tip": { "registerUserId": "ru_kellner", "name": "Ben Kellner", "receivedImmediatelyCents": 0, "retainedCents": 250, "paidOutCents": 0, "openCents": 0 }, "expected": [{ "key": "shift_receipt.tip_earned", "cents": 250 }, { "key": "shift_receipt.tip_retained", "cents": 250 }] },
    { "tip": { "registerUserId": "ru_kellner", "name": "Ben Kellner", "receivedImmediatelyCents": 0, "retainedCents": 0, "paidOutCents": 0, "openCents": 0 }, "expected": [] },
    { "tip": { "registerUserId": "ru_kellner", "name": "Ben Kellner", "receivedImmediatelyCents": -200, "retainedCents": 0, "paidOutCents": 0, "openCents": 0 }, "expected": [{ "key": "shift_receipt.tip_earned", "cents": -200 }] },
    { "tip": { "registerUserId": "ru_kellner", "name": "Ben Kellner", "receivedImmediatelyCents": 200, "retainedCents": -200, "paidOutCents": 0, "openCents": 0 }, "expected": [{ "key": "shift_receipt.tip_earned", "cents": 0 }, { "key": "shift_receipt.tip_retained", "cents": -200 }] },
    { "tip": { "registerUserId": "ru_kellner", "name": "Ben Kellner", "receivedImmediatelyCents": 0, "retainedCents": 0, "paidOutCents": 150, "openCents": -150 }, "expected": [{ "key": "shift_receipt.tip_earned", "cents": 0 }, { "key": "shift_receipt.tip_paid_out", "cents": 150 }, { "key": "shift_receipt.tip_open", "cents": -150 }] }
  ]
}
