                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "subtitle": {
                  "type": "string",
                  "maxLength": 1000
                },
                "quantity": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000,
                  "x-decimals": 3
                },
                "unit": {
                  "enum": [
                    "piece",
                    "pair",
                    "set",
                    "dozen",
                    "second",
                    "minute",
                    "hour",
                    "day",
                    "night",
                    "week",
                    "month",
                    "quarter",
                    "half_year",
                    "year",
                    "milligram",
                    "gram",
                    "kilogram",
                    "tonne",
                    "millimetre",
                    "centimetre",
                    "metre",
                    "running_metre",
                    "kilometre",
                    "square_metre",
                    "hectare",
                    "millilitre",
                    "litre",
                    "cubic_metre",
                    "kilowatt_hour",
                    "megawatt_hour",
                    "gigabyte",
                    "terabyte",
                    "flat_rate",
                    "person",
                    "licence",
                    "user",
                    "device",
                    "session",
                    "trip",
                    "page",
                    "sheet",
                    "package",
                    "box",
                    "carton",
                    "bottle",
                    "can",
                    "roll",
                    "bag",
                    "pallet"
                  ]
                },
                "unitPriceCents": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000000
                },
                "vatRate": {
                  "enum": [
                    0,
                    10,
                    13,
                    20
                  ]
                },
                "discountPct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100,
                  "x-decimals": 2
                }
              },
              "required": [
                "description",
                "quantity",
                "unitPriceCents",
                "vatRate"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "idempotencyKey",
          "invoiceId",
          "reason",
          "items"
        ],
        "additionalProperties": false
      }
    },
    "getInvoice": {
      "anfrage": {
        "type": "object",
        "properties": {
          "invoiceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "number": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "additionalProperties": false
      },
      "genauEins": [
        [
          "invoiceId",
          "number"
        ]
      ]
    },
    "listInvoices": {
      "anfrage": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "format": "date"
          },
          "to": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "format": "date"
          },
          "status": {
            "enum": [
              "final",
              "paid",
              "cancelled",
              "open",
              "overdue"
            ]
          },
          "docType": {
            "enum": [
              "RE",
              "GU"
            ]
          },
          "customerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "limit": {
            "type": "integer",
