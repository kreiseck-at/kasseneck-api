{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kasseneck Rechnungs-API",
  "version": 1,
  "paket": "0.19.0",
  "aufrufe": {
    "createCustomer": {
      "anfrage": {
        "type": "object",
        "properties": {
          "customer": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "private",
                  "company"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "legalForm": {
                "type": "string",
                "maxLength": 40
              },
              "email": {
                "type": "string",
                "maxLength": 254,
                "format": "email"
              },
              "phone": {
                "type": "string",
                "maxLength": 40,
                "format": "phone"
              },
              "street": {
                "type": "string",
                "maxLength": 200
              },
              "houseNumber": {
                "type": "string",
                "maxLength": 20
              },
              "zip": {
                "type": "string",
                "maxLength": 10
              },
              "city": {
                "type": "string",
                "maxLength": 100
              },
              "country": {
                "type": "string",
                "minLength": 2,
                "maxLength": 2,
                "format": "country"
              },
              "vatId": {
                "type": "string",
                "maxLength": 20,
                "format": "vatId"
              },
              "shortCode": {
                "type": "string",
                "maxLength": 8,
                "format": "shortCode"
              },
              "isAuthority": {
                "type": "boolean"
              },
              "note": {
                "type": "string",
                "maxLength": 1000
              },
              "externalId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "language": {
                "enum": [
                  "de",
                  "en"
                ]
              }
            },
            "required": [
              "type",
              "name",
              "country"
            ],
            "additionalProperties": false
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "customer"
        ],
        "additionalProperties": false
      }
    },
    "getCustomer": {
      "anfrage": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "additionalProperties": false
      },
      "genauEins": [
        [
          "customerId",
          "externalId"
        ]
      ]
    },
    "updateCustomer": {
      "anfrage": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "customer": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "private",
                  "company"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "legalForm": {
                "type": "string",
                "maxLength": 40
              },
              "email": {
                "type": "string",
                "maxLength": 254,
                "format": "email"
              },
              "phone": {
                "type": "string",
                "maxLength": 40,
                "format": "phone"
              },
              "street": {
                "type": "string",
                "maxLength": 200
              },
              "houseNumber": {
                "type": "string",
                "maxLength": 20
              },
              "zip": {
                "type": "string",
                "maxLength": 10
              },
              "city": {
                "type": "string",
                "maxLength": 100
              },
              "country": {
                "type": "string",
                "minLength": 2,
                "maxLength": 2,
                "format": "country"
              },
              "vatId": {
                "type": "string",
                "maxLength": 20,
                "format": "vatId"
              },
              "shortCode": {
                "type": "string",
                "maxLength": 8,
                "format": "shortCode"
              },
              "isAuthority": {
                "type": "boolean"
              },
              "note": {
                "type": "string",
                "maxLength": 1000
              },
              "externalId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "language": {
                "enum": [
                  "de",
                  "en"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "customerId",
          "customer"
        ],
        "additionalProperties": false
      }
    },
    "searchCustomers": {
      "anfrage": {
        "type": "object",
        "properties": {
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "vatId": {
            "type": "string",
            "maxLength": 20
          },
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "additionalProperties": false
      },
      "mindestensEins": [
        [
          "externalId",
          "vatId",
          "email",
          "name"
        ]
      ]
    },
    "issueInvoice": {
      "anfrage": {
        "type": "object",
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "customerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "taxScheme": {
            "enum": [
              "normal",
              "smallBusiness",
              "reverseCharge",
              "igLieferung",
              "exportThirdCountry"
            ]
          },
          "priceMode": {
            "enum": [
              "net",
              "gross"
            ]
          },
          "serviceStart": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "format": "date"
          },
          "serviceEnd": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "format": "date"
          },
          "paymentTermDays": {
            "type": "integer",
            "minimum": 0,
            "maximum": 365
          },
          "orderReference": {
            "type": "string",
            "maxLength": 200
          },
          "intro": {
            "type": "string",
            "maxLength": 2000
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          },
          "paymentReference": {
            "type": "string",
            "maxLength": 140
          },
          "girocode": {
            "type": "boolean"
          },
          "tracking": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "subtitle": {
                  "type": "string",
                  "maxLength": 1000
                },
                "quantity": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000,
                  "x-decimals": 3
                },
                "unit": {
                  "enum": [
                    "piece",
                    "pair",
                    "set",
                    "dozen",
                    "second",
                    "minute",
                    "hour",
                    "day",
                    "night",
                    "week",
                    "month",
                    "quarter",
                    "half_year",
                    "year",
                    "milligram",
                    "gram",
                    "kilogram",
                    "tonne",
                    "millimetre",
                    "centimetre",
                    "metre",
                    "running_metre",
                    "kilometre",
                    "square_metre",
                    "hectare",
                    "millilitre",
                    "litre",
                    "cubic_metre",
                    "kilowatt_hour",
                    "megawatt_hour",
                    "gigabyte",
                    "terabyte",
                    "flat_rate",
                    "person",
                    "licence",
                    "user",
                    "device",
                    "session",
                    "trip",
                    "page",
                    "sheet",
                    "package",
                    "box",
                    "carton",
                    "bottle",
                    "can",
                    "roll",
                    "bag",
                    "pallet"
                  ]
                },
                "unitPriceCents": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000000
                },
                "vatRate": {
                  "enum": [
                    0,
                    10,
                    13,
                    20
                  ]
                },
                "discountPct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100,
                  "x-decimals": 2
                }
              },
              "required": [
                "description",
                "quantity",
                "unitPriceCents",
                "vatRate"
              ],
              "additionalProperties": false
            }
          },
          "metadata": {
            "type": "object",
            "maxProperties": 20,
            "propertyNames": {
              "pattern": "^[a-zA-Z0-9_]{1,40}$"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 500
            }
          },
          "language": {
            "enum": [
              "de",
              "en"
            ]
          },
          "brandId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "payment": {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "transfer",
                  "card",
                  "online",
                  "cash"
                ]
              },
              "amountCents": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000000
              },
              "paidAt": {
                "type": "string",
                "minLength": 10,
                "maxLength": 10,
                "format": "date"
              },
              "reference": {
                "type": "string",
                "maxLength": 100
              }
            },
            "required": [
              "method"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "idempotencyKey",
          "taxScheme",
          "priceMode",
          "serviceStart",
          "items"
        ],
        "additionalProperties": false
      }
    },
    "cancelInvoice": {
      "anfrage": {
        "type": "object",
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "invoiceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "reason": {
            "enum": [
              "cancellation",
              "price_reduction",
              "return",
              "incorrect_invoice",
              "other"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "idempotencyKey",
          "invoiceId",
          "reason"
        ],
        "additionalProperties": false
      }
    },
