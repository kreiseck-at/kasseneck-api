{
  "name": "@kreiseck/kasseneck-api",
  "version": "0.22.0",
  "description": "RKSV-Registrierkasse fuer JavaScript und TypeScript: signierte Belege, Storno, Kartenzahlung, Bondruck. Austrian fiscal cash register (RKSV) API client.",
  "license": "Apache-2.0",
  "author": "Kreiseck",
  "homepage": "https://kasseneck.at/api-doku",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kreiseck-at/kasseneck-api.git"
  },
  "bugs": "https://github.com/kreiseck-at/kasseneck-api/issues",
  "keywords": [
    "kasseneck",
    "rksv",
    "registrierkasse",
    "kassensystem",
    "kassensoftware",
    "belegerteilungspflicht",
    "finanzonline",
    "dep",
    "beleg",
    "bon",
    "bondrucker",
    "escpos",
    "oesterreich",
    "österreich",
    "austria",
    "austrian",
    "fiscal",
    "cash-register",
    "point-of-sale",
    "pos",
    "receipt",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./receipt": {
      "import": {
        "types": "./dist/esm/receipt/index.d.ts",
        "default": "./dist/esm/receipt/index.js"
      },
      "require": {
        "types": "./dist/cjs/receipt/index.d.ts",
        "default": "./dist/cjs/receipt/index.js"
      }
    },
    "./payments": {
      "import": {
        "types": "./dist/esm/payments/index.d.ts",
        "default": "./dist/esm/payments/index.js"
      },
      "require": {
        "types": "./dist/cjs/payments/index.d.ts",
        "default": "./dist/cjs/payments/index.js"
      }
    },
    "./printing": {
      "import": {
        "types": "./dist/esm/printing/index.d.ts",
        "default": "./dist/esm/printing/index.js"
      },
      "require": {
        "types": "./dist/cjs/printing/index.d.ts",
        "default": "./dist/cjs/printing/index.js"
      }
    },
    "./register": {
      "import": {
        "types": "./dist/esm/register/index.d.ts",
        "default": "./dist/esm/register/index.js"
      },
      "require": {
        "types": "./dist/cjs/register/index.d.ts",
        "default": "./dist/cjs/register/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/esm/react/index.d.ts",
        "default": "./dist/esm/react/index.js"
      },
      "require": {
        "types": "./dist/cjs/react/index.d.ts",
        "default": "./dist/cjs/react/index.js"
      }
    },
    "./kasse": {
      "import": {
        "types": "./dist/esm/kasse/index.d.ts",
        "default": "./dist/esm/kasse/index.js"
      },
      "require": {
        "types": "./dist/cjs/kasse/index.d.ts",
        "default": "./dist/cjs/kasse/index.js"
      }
    },
    "./partner": {
      "import": {
        "types": "./dist/esm/partner/index.d.ts",
        "default": "./dist/esm/partner/index.js"
      },
      "require": {
        "types": "./dist/cjs/partner/index.d.ts",
        "default": "./dist/cjs/partner/index.js"
      }
    },
    "./rechnung": {
      "import": {
        "types": "./dist/esm/rechnung/index.d.ts",
        "default": "./dist/esm/rechnung/index.js"
      },
      "require": {
        "types": "./dist/cjs/rechnung/index.d.ts",
        "default": "./dist/cjs/rechnung/index.js"
      }
    },
    "./rechnung/rechnen": {
      "import": {
        "types": "./dist/esm/rechnung/rechnen.d.ts",
        "default": "./dist/esm/rechnung/rechnen.js"
      },
      "require": {
        "types": "./dist/cjs/rechnung/rechnen.d.ts",
        "default": "./dist/cjs/rechnung/rechnen.js"
      }
    },
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist",
    "fixtures",
    "README.md",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }))\" && node scripts/check-build-exports.mjs",
    "prepare": "npm run build",
    "test": "tsc -p tsconfig.test.json && TZ=Europe/Vienna node --test $(find test-dist -name '*.test.js') && TZ=UTC node --test $(find test-dist -name '*.test.js') && TZ=Pacific/Kiritimati node --test $(find test-dist -name '*.test.js')",
    "check:consumer": "node scripts/check-consumer-types.mjs",
    "check:erreichbar": "node scripts/check-erreichbarkeit.mjs",
    "prepublishOnly": "npm run build",
    "fixtures:erneuern": "npm run build && node scripts/belege-fixtures.mjs",
    "fixtures:kasse": "npm run build && node scripts/kasse-settings-fixture.mjs",
    "fixtures:oberflaeche": "npm run build && node scripts/oberflaeche.mjs",
    "fixtures:rechnung": "npm run build && node scripts/rechnung-vertrag.mjs",
    "fixtures:rechnungstexte": "npm run build && node scripts/rechnung-texte.mjs",
    "fixtures:hobex-hps-codes": "npm run build && node scripts/hobex-hps-codes.mjs",
    "fixtures:texte": "npm run build && node scripts/texte.mjs",
    "fixtures:rechnungzufall": "python3 scripts/rechnung-referenz.py --erzeuge --seed 20260918 --anzahl 400 --ziel fixtures/rechnung-rechnen-zufall.json"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.4.0"
  }
}
